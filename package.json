    "cors": "^2.8.5",
    "express": "^4.18.3",
    "multer": "^2.1.1",
    "pdfkit": "^0.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
