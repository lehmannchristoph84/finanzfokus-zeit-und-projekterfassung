{
  "name": "finanzfokus-zeiterfassung",
  "version": "1.0.0",
  "description": "Projektzeiterfassung für Finanzfokus GmbH",
  "scripts": {
    "dev": "concurrently --names \"Backend,Frontend\" --prefix-colors \"cyan,magenta\" \"node server/index.js\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js",
    "install:all": "npm install && npm --prefix client install"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "multer": "^2.1.1",
    "pdfkit": "^0.15.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
